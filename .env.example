# Postgres (Railway te da esta URL en la pestaña "Connect" del servicio de DB)
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# WhatsApp Cloud API (Meta) — cumpleaños y avisos de meta de puntos
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Secreto para proteger POST /api/cron (llamado por el scheduler de Railway)
CRON_SECRET=

# Notificaciones push al celular (recordatorio 1h antes + resumen 8am).
# Generar un par nuevo con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY debe ser IDÉNTICA a VAPID_PUBLIC_KEY — la
# pública se expone al navegador a propósito, así funciona VAPID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Opcional — habilita el simulador del bot de WhatsApp en el Panel
ANTHROPIC_API_KEY=

# Login del consultorio (un solo usuario) — protege todo /dashboard
APP_LOGIN_USER=
APP_LOGIN_PASSWORD=
# Cualquier cadena larga y aleatoria — firma la cookie de sesión
SESSION_SECRET=
